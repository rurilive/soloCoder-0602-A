# ==============
# 项目根目录 .gitignore
# ==============

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 编辑器/IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Python 通用 ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python 虚拟环境 ---
.venv
.venv/
venv
venv/
env
env/
ENV
ENV/
.uv

# --- Python 测试/覆盖率 ---
.pytest_cache/
.coverage
.tox/
.nox/
.coverage.*
.cache
htmlcov/

# --- uv ---
.uv/

# --- 数据库 ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
forum.db
forum.db.backup_*

# --- 上传文件 ---
uploads/

# --- 前端 (子目录有 .gitignore，这里做冗余保护) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# --- 日志 ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
