# ==============
# 后端 .gitignore
# ==============

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
.uv/

# uv 产物
*.egg-info/
dist/
build/

# 数据库
*.db
*.db.*
forum.db
forum.db.backup_*
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# 上传文件
uploads/

# 测试/覆盖率
.pytest_cache/
.coverage
htmlcov/

# 临时文件
*.tmp
*.temp
